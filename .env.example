# Database
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"
# Direct connection used for migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-west-1.pooler.supabase.com:5432/postgres?schema=public"

# JWT (JWT_SECRET must be identical in auth-service and habit-service)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Shared secret for service-to-service calls (must match in both services)
INTERNAL_API_KEY=change-me-internal-key

# Environment
NODE_ENV=production
PORT=3000

# CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3000

# Services
AUTH_SERVICE_URL=http://auth-service:3000

# Firebase Admin SDK (path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
