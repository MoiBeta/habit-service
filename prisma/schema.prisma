generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Habit {
  id          String   @id @default(uuid())
  name        String
  description String?

  priority    Int      @default(100)
  frequency   String   @default("DAILY")  // DAILY, WEEKLY, MONTHLY, YEARLY

  userId      String   // 🔥 referencia lógica, no relación

  entries     HabitEntry[]
  subTasks    SubTask[]
  reminders   Reminder[]

  createdAt   DateTime @default(now())

  @@index([userId, priority])
}

model SubTask {
  id        String   @id @default(uuid())
  title     String
  orderId   Int      @default(0)

  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Reminder {
  id          String   @id @default(uuid())
  timeMinutes Int      // local time, minutes since midnight
  utcOffsetMinutes Int @default(0) // device UTC offset when it was saved
  timezone    String?  // IANA time zone (e.g. America/Bogota); follows DST changes
  enabled     Boolean  @default(true)

  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model HabitEntry {
  id          String   @id @default(uuid())
  date        DateTime
  completed   Boolean  @default(false)
  completedAt DateTime?

  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  subTasks    EntrySubTask[]

  createdAt   DateTime @default(now())

  @@unique([habitId, date])
}

model EntrySubTask {
  id              String   @id @default(uuid())
  title           String
  completed       Boolean  @default(false)
  orderId         Int      @default(0)
  sourceSubTaskId String?

  entryId         String
  entry           HabitEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}